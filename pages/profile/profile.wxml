<view class="page">
    <view class="card login-card" wx:if="{{authState === 'signed-out'}}">
        <text class="login-title">未登录</text>
        <text class="login-desc">前往登录页，用账号密码登录或注册。</text>
        <button class="btn-ghost" bindtap="onGoLogin">去登录</button>
    </view>

    <block wx:else>
        <view class="masthead">
            <text class="masthead-eyebrow">ACCOUNT / 个人空间</text>
            <text class="masthead-title">我的</text>
            <view class="masthead-meta">
                <text>云端专属空间</text>
                <text>仅本人可见</text>
            </view>
            <view class="masthead-tools">
                <ui-icon class="tool-icon" name="settings" size="44rpx" bindtap="onOpenSettings" />
                <view class="tool-bell" bindtap="onOpenMessages">
                    <ui-icon class="tool-icon" name="bell" size="44rpx" />
                    <view class="tool-dot" wx:if="{{unreadCount > 0}}"></view>
                </view>
            </view>
        </view>

        <view class="profile-content">
            <view class="identity">
                <view class="avatar-mark" style="background: {{avatar.bg}}; color: {{avatar.fg}};" bindtap="onAvatarTap">{{avatar.glyph}}</view>
                <view class="identity-txt">
                    <view class="identity-name">
                        <text class="identity-nickname">{{nickname || '未设置昵称'}}</text>
                        <text class="identity-edit" bindtap="onNicknameTap">编辑</text>
                    </view>
                    <text class="identity-desc">数据保存在你的专属云端空间，仅本人可见 · 点击头像可更换</text>
                </view>
            </view>

            <block wx:if="{{stats}}">
                <view class="sec-label">我的数据 / OVERVIEW</view>
                <view class="statbig">
                    <view class="statbig-main">
                        <text class="statbig-n">{{stats.entries}}</text>
                        <text class="statbig-u">条记录</text>
                    </view>
                    <text class="statbig-open">未完成 {{stats.open}}</text>
                </view>
                <view class="statmini">
                    <view class="statmini-cell">
                        <text class="statmini-n">{{stats.ideas}}</text>
                        <text class="statmini-u">想法</text>
                    </view>
                    <view class="statmini-cell">
                        <text class="statmini-n">{{stats.materials}}</text>
                        <text class="statmini-u">资料</text>
                    </view>
                    <view class="statmini-cell">
                        <text class="statmini-n">{{stats.todos}}</text>
                        <text class="statmini-u">待办</text>
                    </view>
                    <view class="statmini-cell">
                        <text class="statmini-n statmini-warn">{{stats.open}}</text>
                        <text class="statmini-u">未完成</text>
                    </view>
                </view>
            </block>

            <view class="signout" bindtap="onSignOut">退出登录</view>
        </view>
    </block>

    <avatar-picker
        visible="{{showAvatarPicker}}"
        current="{{avatar.id}}"
        bind:select="onAvatarSelect"
        bind:close="onClosePicker"
    />
</view>
