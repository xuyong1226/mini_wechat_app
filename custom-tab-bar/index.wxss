/* 悬浮胶囊 Tab Bar：高 124rpx(62px) / 圆角 72rpx(36px) / 纸白底 + 1px 细线 */

.tabbar-wrap {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 24rpx 42rpx calc(42rpx + env(safe-area-inset-bottom));
    pointer-events: none;
    z-index: 999;
}

.pill {
    height: 124rpx;
    border-radius: 72rpx;
    /* 玻璃拟态：底色全透明，靠背景模糊 + 边框高光 + 内外阴影营造通透磨砂质感 */
    background: transparent;
    -webkit-backdrop-filter: blur(26rpx) saturate(170%);
    backdrop-filter: blur(26rpx) saturate(170%);
    border: 1rpx solid rgba(255, 255, 255, 0.55);
    box-shadow:
        inset 0 1rpx 0 rgba(255, 255, 255, 0.8),
        inset 0 0 0 1rpx rgba(26, 26, 26, 0.05),
        0 12rpx 30rpx rgba(26, 26, 26, 0.12);
    display: flex;
    padding: 8rpx;
    pointer-events: auto;
}

.tabitem {
    flex: 1;
    border-radius: 52rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6rpx;
    color: var(--ink2);
}

/* 按压反馈（hover-class）：整项轻微压暗，激活项同样可辨识 */
.tabitem-hover {
    opacity: 0.6;
}

.tabitem.on {
    background: var(--ink);
    color: var(--paper);
    box-shadow: 0 6rpx 18rpx rgba(26, 26, 26, 0.28);
}

.tabtext {
    font-size: 20rpx;
    font-weight: 600;
    letter-spacing: 1rpx;
    /* 双层浅色描边光晕：玻璃底（尤其压深色渐变）上保证文字对比度 */
    text-shadow:
        0 1rpx 3rpx rgba(255, 254, 250, 0.95),
        0 0 8rpx rgba(255, 254, 250, 0.75);
}

.tabitem.on .tabtext {
    text-shadow: none;
}

.dot {
    width: 8rpx;
    height: 8rpx;
    border-radius: 50%;
    background: transparent;
}

.tabitem.on .dot {
    background: var(--red);
}
