/* 悬浮胶囊 Tab Bar：高 124rpx(62px) / 圆角 72rpx(36px) / 实底纸白 + 1rpx 细线（对齐设计稿） */

.tabbar-wrap {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 24rpx 42rpx calc(42rpx + env(safe-area-inset-bottom));
    pointer-events: none;
    z-index: 999;
}

.pill {
    height: 124rpx;
    border-radius: 72rpx;
    /* 设计稿：实底纸白 + 1rpx 细线边框 + 柔和投影（去掉玻璃拟态） */
    background: var(--sheet);
    border: 1rpx solid var(--rule);
    box-shadow: 0 12rpx 30rpx rgba(26, 26, 26, 0.12);
    display: flex;
    padding: 8rpx;
    pointer-events: auto;
}

.tabitem {
    flex: 1;
    border-radius: 52rpx;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6rpx;
    color: var(--ink2);
}

/* 按压反馈（hover-class）：整项轻微压暗，激活项同样可辨识 */
.tabitem-hover {
    opacity: 0.6;
}

.tabitem.on {
    background: var(--ink);
    color: var(--paper);
    box-shadow: 0 6rpx 18rpx rgba(26, 26, 26, 0.28);
}

.tabtext {
    font-size: 20rpx;
    font-weight: 600;
    letter-spacing: 1rpx;
}

.tabitem.on .tabtext {
    text-shadow: none;
}

.dot {
    width: 8rpx;
    height: 8rpx;
    border-radius: 50%;
    background: transparent;
}

.tabitem.on .dot {
    background: var(--red);
}
